{
  "name": "@heiwa4126/fib-wasm",
  "version": "0.0.1",
  "description": "A Fibonacci calculator for Node.js and browsers, implemented in Rust and compiled to WebAssembly.",
  "keywords": [
    "demo",
    "example",
    "fibonacci",
    "browser",
    "nodejs",
    "rust",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/heiwa4126/fib-wasm#readme",
  "bugs": {
    "url": "https://github.com/heiwa4126/fib-wasm/issues"
  },
  "license": "MIT",
  "author": "heiwa4126 <heiwa4126@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heiwa4126/fib-wasm.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist",
    "browser.mjs"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.mjs",
      "node": "./index.js",
      "default": "./browser.mjs"
    }
  },
  "scripts": {
    "test": "run-s test:rust test:node",
    "test:rust": "cargo test",
    "test:node": "run-s build node:test",
    "node:test": "node --conditions=browser --test",
    "build:rust": "run-s build:rust:node build:rust:web",
    "build:rust:node": "cargo build --release --target wasm32-unknown-emscripten",
    "build:rust:web": "cargo --config .cargo/config.web.toml build --release --target wasm32-unknown-emscripten --target-dir target/web",
    "build:copy": "node script/build-copy.cjs",
    "build": "run-s build:rust build:copy",
    "prepublishOnly": "run-s test smoke-test",
    "prepack": "npm run build",
    "smoke-test": "run-s smoke-test:cjs smoke-test:mjs smoke-test:ts",
    "smoke-test:cjs": "node example/fib.cjs",
    "smoke-test:mjs": "node example/fib.mjs",
    "smoke-test:ts": "node example/fib.ts",
    "format:rust": "cargo fmt",
    "format:others": "oxfmt",
    "format": "run-s format:rust format:others"
  },
  "devDependencies": {
    "@heiwa4126/fib-wasm": "link:",
    "npm-run-all2": "^9.0.4"
  }
}
